# Comma-separated frontend origins. For a unified same-origin deployment,
# this is not required for browser calls to the same host.
ALLOWED_ORIGINS=http://localhost:5173

# NeuralSeek is optional and is NOT used by the current local classifier.
# No staging tenant is hard-coded: configure all three values before using
# /api/stream/frame-sse.
NEURALSEEK_API_KEY=
NEURALSEEK_AGENT_ID=
NEURALSEEK_AGENT_NAME=
NEURALSEEK_STREAM_URL=

# Required for the Speak / audio button.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
